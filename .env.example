# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 排盘本身不需要任何 Key；只有 AI 解读（/api/interpret）与合盘分析（/api/heming）需要。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选：模型与预算（不填用默认值）
# DEEPSEEK_MODEL=deepseek-v4-pro     # 默认 deepseek-v4-pro，可换 deepseek-flash
# AI_MAX_TOKENS=8192                 # 单次回答上限
# AI_THINKING=off                    # DeepSeek V4 的思考 token 也计入 AI_MAX_TOKENS，
#                                    # 长 prompt（合盘）时容易把预算吃光导致正文为空，默认 off

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 通用覆盖（任何供应商都生效，优先级最高）───
# AI_API_KEY=sk-xxx
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
